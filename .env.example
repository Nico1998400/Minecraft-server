# Copy this file to ".env" (gitignored) and fill in your values. ".env" is read by:
#   - ./gradlew :swedencore:runServer  (passed to the dev server)
#   - docker compose                   (database settings)
# On a real server, set the same names as environment variables instead.

# AI key for the guide NPC (Brage). Either a Google Gemini key (aistudio.google.com, default model gemini-3.1-flash-lite)
# or an Anthropic key (sk-ant-..., then set model to a claude-... model in the guide package: guide/guide.yml).
# Without it Brage still stands at spawn but only points players to /meny.
NORDIA_AI_API_KEY=

# Discord bot token for /link (optional). Create the bot at https://discord.com/developers/applications and switch it on in
# discord/discord.yml in the plugin source (bot.enabled). Never commit it.
NORDIA_DISCORD_TOKEN=

# Database (the defaults match docker-compose.yml; override only if you changed them)
# NORDIA_DB_HOST=localhost
# NORDIA_DB_PORT=5432
# NORDIA_DB_NAME=nordia
# NORDIA_DB_USER=nordia
# NORDIA_DB_PASSWORD=nordia_dev_only
